{
  "name": "alltagsengel-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build --turbopack",
    "build:webpack": "NODE_OPTIONS='--max-old-space-size=4096' next build --webpack",
    "analyze": "ANALYZE=true NODE_OPTIONS='--max-old-space-size=4096' next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "audit:rls": "tsx scripts/audit-rls.ts",
    "verify:profiles-rls": "node scripts/verify-profiles-rls.mjs",
    "rls:matrix": "tsx scripts/rls-matrix.ts",
    "rls:matrix:check": "tsx scripts/rls-matrix.ts --check",
    "lint:forbidden": "tsx scripts/lint-forbidden.ts",
    "check:schema-drift": "node scripts/schema-drift-check.mjs",
    "budget:nachziehen": "tsx scripts/budget-nachziehen.ts",
    "generate:plz-sql": "tsx scripts/generate-plz-bundesland-sql.ts",
    "lint:forbidden:staged": "tsx scripts/lint-forbidden.ts --staged",
    "indexnow:ping": "node scripts/indexnow-ping.mjs",
    "setup:hooks": "bash scripts/hooks/install.sh",
    "cap:sync": "npx cap sync ios",
    "cap:open": "npx cap open ios",
    "cap:sync:android": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "cap:build:android": "npx cap sync android && cd android && ./gradlew bundleRelease",
    "cap:sync:all": "npx cap sync",
    "test:unit": "NODE_OPTIONS=\"--require ./scripts/test-stubs/server-only-stub.cjs\" tsx --test $(find lib -name '*.test.ts')",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "lastmod:generate": "node scripts/generate-lastmod.mjs",
    "prebuild": "node scripts/generate-lastmod.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test:unit && vitest run && npm run build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --target universal-apple-darwin",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:icons": "tauri icon src-tauri/icons/icon.png",
    "dipa:katalog": "tsx scripts/dipa-katalog-check.ts",
    "dipa:compliance": "tsx scripts/dipa-compliance-check.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
