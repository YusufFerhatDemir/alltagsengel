    "pptxgenjs": "^3.12.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "resend": "^6.9.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "ssh2-sftp-client": "^12.0.1",
    "stripe": "^22.4.0",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "web-vitals": "^5.2.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
