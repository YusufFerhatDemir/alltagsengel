    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/nextjs": "^10.49.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@types/leaflet": "^1.9.21",
    "@zxcvbn-ts/core": "^3.0.4",
