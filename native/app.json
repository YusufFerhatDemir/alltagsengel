{
  "expo": {
    "name": "Alltagsengel",
    "slug": "alltagsengel",
    "owner": "yusufferhatdemirs-team",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alltagsengel",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1A1612",
    "primaryColor": "#C9963C",
    "ios": {
      "bundleIdentifier": "care.alltagsengel.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "de",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Alltagsengel benötigt Zugriff auf die Kamera, um Leistungsnachweise zu fotografieren.",
        "NSPhotoLibraryUsageDescription": "Alltagsengel benötigt Zugriff auf Ihre Fotos, um Leistungsnachweise aus der Galerie hochzuladen.",
        "NSLocationWhenInUseUsageDescription": "Alltagsengel benötigt Ihren Standort, um den Einsatzort beim Check-in/Check-out zu bestätigen."
      }
    },
    "android": {
      "package": "care.alltagsengel.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A1612",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1612",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9963C"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Alltagsengel benötigt Zugriff auf die Kamera, um Leistungsnachweise zu fotografieren."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Alltagsengel benötigt Zugriff auf Ihre Fotos, um Leistungsnachweise aus der Galerie hochzuladen.",
          "cameraPermission": "Alltagsengel benötigt Zugriff auf die Kamera, um Leistungsnachweise zu fotografieren."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Alltagsengel benötigt Ihren Standort, um den Einsatzort beim Check-in/Check-out zu bestätigen."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/31ccfd24-7d4b-4e85-a0e8-f485bbe6baea"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "31ccfd24-7d4b-4e85-a0e8-f485bbe6baea"
      }
    }
  }
}
