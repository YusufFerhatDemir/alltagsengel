{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alltagsengel",
  "version": "1.0.0",
  "identifier": "care.alltagsengel.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "TAURI_BUILD=1 npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Alltagsengel — Pflege & Betreuung",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Healthcare",
    "copyright": "© 2026 Alltagsengel UG",
    "shortDescription": "Alltagsengel — Pflege & Betreuung",
    "longDescription": "Desktop-App der Alltagsengel UG: Alltagsbegleitung, Betreuung und Verwaltung für Kundinnen, Kunden und das Büro-Team.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "de-DE"
      }
    }
  }
}
