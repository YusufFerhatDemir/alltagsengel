# ═══════════════════════════════════════════════════════════
# AlltagsEngel.care — Environment Variables Template
# ═══════════════════════════════════════════════════════════
# Kopiere diese Datei zu `.env.local` und fülle echte Werte ein.
# .env.local wird NICHT committed (siehe .gitignore).

# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Sentry (Error-Tracking + Performance) ────────────────
# DSN: findest du in Sentry → Settings → Projects → Client Keys
SENTRY_DSN=https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID

# Build-Time (Source-Map-Upload): Sentry → User Auth Tokens
SENTRY_AUTH_TOKEN=sntrys_YOUR_AUTH_TOKEN
SENTRY_ORG=alltagsengel
SENTRY_PROJECT=alltagsengel-web

# ─── Analytics & Marketing ────────────────────────────────
# Welle-1 ENVs — werden bei Account-Anlage in SETUP_ACCOUNTS.md gefüllt.
# Solange leer: Komponenten rendern nichts, Build bleibt grün.

# GTM (legacy, bestehend)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4 — Web-Stream Measurement-ID (G-XXXXXXXXXX)
# Anlage: https://analytics.google.com → Property → Web-Stream
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Meta (Facebook/Instagram) Pixel
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
# Meta Conversions API — Server-side Token, NICHT NEXT_PUBLIC
META_CAPI_ACCESS_TOKEN=
# (Pixel-ID server-seitig zur Sicherheit doppelt halten)
META_PIXEL_ID=

# TikTok Pixel
NEXT_PUBLIC_TIKTOK_PIXEL_ID=your-tiktok-pixel-id
# TikTok Events-API — Server-side Token
TIKTOK_CAPI_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=

# Bing Webmaster (optional — nur zur Verifikation)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Firebase (Welle 2 — App-Tracking iOS/Android)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID_IOS=
NEXT_PUBLIC_FIREBASE_APP_ID_ANDROID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID_WEB=

# ─── AI / LLM ─────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=...

# ─── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Push Notifications (Web Push VAPID) ──────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:info@alltagsengel.care

# ─── Stripe (Multi-Mandant SaaS Billing) ──────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_SCALE=price_...

# ─── Geo / Location ───────────────────────────────────────
# (IP-API ist keyless, aber für höhere Limits Token nutzen)

# ─── Vercel (automatisch gesetzt in Production) ───────────
# VERCEL_GIT_COMMIT_SHA=auto-set-by-vercel
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=auto-set-by-vercel

# ─── Vitalwerte: Grenzwert-Alarme (MDR-Kill-Switch) ───────
# Automatische Bewertung von Vitalwerten gegen Grenzwerte (Warnung/kritisch)
# kann eine Medizinprodukt-Funktion sein. FAIL-CLOSED: nur 'true' aktiviert sie.
# Erst NACH dokumentierter regulatorischer Abnahme setzen — siehe
# docs/VITALWERTE_REGULATORIK.md. Erfassung + Verlauf sind davon unabhängig.
# VITALS_GRENZWERT_ALARME_AKTIV=false

# ─── Digitaler PflegeCoach (DiPA, Block 15) ───────────────
# Pfeffer für das Hashen der Freischaltcodes. Codes werden nie im Klartext
# gespeichert: SHA-256 über (normalisierter Code + Pfeffer).
# ACHTUNG: Wird der Wert nachträglich geändert, lassen sich bereits
# ausgegebene Codes nicht mehr einlösen. Zufälliger Wert, min. 32 Zeichen.
# COACH_CODE_PEPPER=

# Freischaltcode als Zugangsvoraussetzung? Default AUS — ob ein
# Code-Verfahren für DiPA vorgesehen ist, ist regulatorisch offen
# (audit/dipa/nutzerflow_dipa.md, GAP-DIPA-FLOW). Der Mechanismus ist
# gebaut und mit 'true' sofort scharf.
# COACH_FREISCHALTUNG_PFLICHT=false

# Erfassung pseudonymisierter Nutzungsereignisse für die Evaluation.
# Default AUS. Zusätzlich immer abhängig von der Einwilligung
# 'wissenschaftliche_auswertung' des jeweiligen Nutzers — der Schalter
# allein genügt nie. Vor Pilotstart auf 'true' setzen.
# COACH_NUTZUNGSNACHWEIS_AKTIV=false
