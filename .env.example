# ═══════════════════════════════════════════════════════════
# AlltagsEngel.care — Environment Variables Template
# ═══════════════════════════════════════════════════════════
# Kopiere diese Datei zu `.env.local` und fülle echte Werte ein.
# .env.local wird NICHT committed (siehe .gitignore).

# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# NEUES Key-Modell (bevorzugt). Dashboard → Settings → API Keys →
# „Publishable and secret API keys". Beide Modelle laufen parallel; der Code
# liest immer zuerst die neuen Namen und faellt sonst auf die Legacy-Namen
# zurueck. Legacy-Keys werden von Supabase Ende 2026 abgekuendigt.
# Achtung: die neuen Keys sind KEINE JWTs — sie duerfen nur im `apikey`-Header
# stehen, nie als `Authorization: Bearer`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# LEGACY (Fallback, solange die neuen Keys nicht gesetzt sind)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Sentry (Error-Tracking + Performance) ────────────────
# DSN: findest du in Sentry → Settings → Projects → Client Keys
SENTRY_DSN=https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID

# Build-Time (Source-Map-Upload): Sentry → User Auth Tokens
SENTRY_AUTH_TOKEN=sntrys_YOUR_AUTH_TOKEN
SENTRY_ORG=alltagsengel
SENTRY_PROJECT=alltagsengel-web

# ─── Analytics & Marketing ────────────────────────────────
# Welle-1 ENVs — werden bei Account-Anlage in SETUP_ACCOUNTS.md gefüllt.
# Solange leer: Komponenten rendern nichts, Build bleibt grün.

# GTM (legacy, bestehend)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4 — Web-Stream Measurement-ID (G-XXXXXXXXXX)
# Anlage: https://analytics.google.com → Property → Web-Stream
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Meta (Facebook/Instagram) Pixel
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
# Meta Conversions API — Server-side Token, NICHT NEXT_PUBLIC
META_CAPI_ACCESS_TOKEN=
# (Pixel-ID server-seitig zur Sicherheit doppelt halten)
META_PIXEL_ID=

# TikTok Pixel
NEXT_PUBLIC_TIKTOK_PIXEL_ID=your-tiktok-pixel-id
# TikTok Events-API — Server-side Token
TIKTOK_CAPI_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=

# Bing Webmaster (optional — nur zur Verifikation)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Firebase (Welle 2 — App-Tracking iOS/Android)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID_IOS=
NEXT_PUBLIC_FIREBASE_APP_ID_ANDROID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID_WEB=

# ─── AI / LLM ─────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=...

# ─── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Rechnungs- und Mahnversand ───────────────────────────
# Beide Schalter sind AUS, solange sie nicht exakt auf '1' stehen.
# Ohne sie wird nichts automatisch an Kunden verschickt; der manuelle
# Versand ueber /admin/rechnungen/[id] bzw. /admin/mahnwesen bleibt
# unabhaengig davon jederzeit moeglich.
#
# RECHNUNGSVERSAND_AUTOMATISCH: schickt die Rechnung direkt nach der
#   Festschreibung als PDF-Anhang an die E-Mail-Adresse des Klienten
#   (POST /api/billing/invoices/[id]/freeze).
# MAHNVERSAND_AUTOMATISCH: laesst den naechtlichen Mahnlauf
#   (/api/cron/mahnlauf) die wartenden Mahnschreiben aus
#   dunning_email_queue auch versenden, statt sie nur einzustellen.
#
# Ohne RESEND_API_KEY bleibt beides wirkungslos: der Versand meldet
# 'uebersprungen', invoices.sent_at bleibt leer und Queue-Eintraege
# bleiben auf 'wartend' — es geht nichts verloren.
# RECHNUNGSVERSAND_AUTOMATISCH=0
# MAHNVERSAND_AUTOMATISCH=0

# ─── Push Notifications (Web Push VAPID) ──────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:info@alltagsengel.care

# ─── Stripe (Multi-Mandant SaaS Billing) ──────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_SCALE=price_...

# ─── Geo / Location ───────────────────────────────────────
# (IP-API ist keyless, aber für höhere Limits Token nutzen)

# ─── Vercel (automatisch gesetzt in Production) ───────────
# VERCEL_GIT_COMMIT_SHA=auto-set-by-vercel
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=auto-set-by-vercel

# ─── Vitalwerte: Grenzwert-Alarme (MDR-Kill-Switch) ───────
# Automatische Bewertung von Vitalwerten gegen Grenzwerte (Warnung/kritisch)
# kann eine Medizinprodukt-Funktion sein. FAIL-CLOSED: nur 'true' aktiviert sie.
# Erst NACH dokumentierter regulatorischer Abnahme setzen — siehe
# docs/VITALWERTE_REGULATORIK.md. Erfassung + Verlauf sind davon unabhängig.
# VITALS_GRENZWERT_ALARME_AKTIV=false

# ─── Digitaler PflegeCoach (DiPA, Block 15) ───────────────
# DiPA-Modus. Default AUS — der PflegeCoach läuft als normaler digitaler
# Pflege-/Assistenzservice und ist ohne Verzeichnis-Listung nutzbar.
# Erst auf 'true' setzen, wenn eine Listung tatsächlich vorliegt: dann
# werden Anspruchsprüfung, Kassenreferenzen und Abrechnungswege im UI
# sichtbar (/pflegecoach/anspruch, /api/coach/anspruch).
# Solange AUS: keine Erstattungs- oder Kostenträgeraussage im Produkt.
# COACH_DIPA_MODUS=false

# Pfeffer für das Hashen der Freischaltcodes. Codes werden nie im Klartext
# gespeichert: SHA-256 über (normalisierter Code + Pfeffer).
# ACHTUNG: Wird der Wert nachträglich geändert, lassen sich bereits
# ausgegebene Codes nicht mehr einlösen. Zufälliger Wert, min. 32 Zeichen.
# COACH_CODE_PEPPER=

# Freischaltcode als Zugangsvoraussetzung? Default AUS — ob ein
# Code-Verfahren für DiPA vorgesehen ist, ist regulatorisch offen
# (audit/dipa/nutzerflow_dipa.md, GAP-DIPA-FLOW). Der Mechanismus ist
# gebaut und mit 'true' sofort scharf.
# COACH_FREISCHALTUNG_PFLICHT=false

# Erfassung pseudonymisierter Nutzungsereignisse für die Evaluation.
# Default AUS. Zusätzlich immer abhängig von der Einwilligung
# 'wissenschaftliche_auswertung' des jeweiligen Nutzers — der Schalter
# allein genügt nie. Vor Pilotstart auf 'true' setzen.
# COACH_NUTZUNGSNACHWEIS_AKTIV=false

# ─────────────────────────────────────────────────────────────────
# PflegeCoach — Selbstzahler-Verkauf
# ─────────────────────────────────────────────────────────────────
# HAUPTSCHALTER. Default AUS: Solange dieser Wert nicht 'true' ist,
# verweigert der gesamte Bestellweg die Annahme — Bestellseite, API und
# Stripe-Sitzung. Grund: Die Beträge in lib/coach/pricing.ts sind
# PLATZHALTER und kaufmännisch nicht entschieden. Erst umlegen, wenn
# alle Punkte der Freigabe-Checkliste im Kopf von lib/coach/pricing.ts
# erledigt sind. Mit dem Umlegen wird zugleich /pflegecoach/start
# indexierbar (siehe app/pflegecoach/_lib/seitentitel.ts).
# COACH_PREISE_FREIGEGEBEN=false

# Preise in CENT (nicht Euro). Ohne Angabe gelten die Platzhalter aus
# lib/coach/pricing.ts — die dürfen niemandem berechnet werden.
# COACH_PREIS_MONATLICH_CENT=
# COACH_PREIS_JAEHRLICH_CENT=

# Kostenlose Testphase in Tagen. 0 oder leer = keine Testphase.
# COACH_TESTPHASE_MONATLICH_TAGE=0
# COACH_TESTPHASE_JAEHRLICH_TAGE=0

# Stripe-Price-IDs der beiden Tarife. Fehlt eine, ist genau dieser Tarif
# nicht bestellbar (fail-closed, kein stiller Fallback auf den anderen).
# COACH_STRIPE_PRICE_MONATLICH=price_...
# COACH_STRIPE_PRICE_JAEHRLICH=price_...

# EIGENES Webhook-Geheimnis für /api/coach/webhook. NICHT dasselbe wie
# STRIPE_WEBHOOK_SECRET: Der PflegeCoach hat einen eigenen Stripe-
# Endpunkt, damit ein Fehler im Coach-Weg das B2B-Abo nicht beschädigt.
# COACH_STRIPE_WEBHOOK_SECRET=whsec_...

# Umsatzsteuer. Default: Kleinunternehmer nach § 19 UStG — es wird keine
# Steuer ausgewiesen, dafür steht der Pflichthinweis auf der Rechnung.
# Auf 'false' setzen, sobald regelbesteuert wird, und den Satz angeben.
# COACH_UST_KLEINUNTERNEHMER=true
# COACH_UST_SATZ=19

# Steuernummer bzw. USt-IdNr. für die Rechnung (§ 14 Abs. 4 UStG).
# SOLANGE BEIDE LEER SIND, ist jede ausgestellte Rechnung formal
# unvollständig; das wird in coach_rechnungen.angaben_unvollstaendig
# vermerkt und protokolliert, aber nicht stillschweigend übergangen.
# COACH_STEUERNUMMER=
# COACH_UST_ID_NR=

# ─────────────────────────────────────────────────────────────────
# Kassenabrechnung — externe Freigaben (Stream 2)
# ─────────────────────────────────────────────────────────────────
# Diese drei Schalter behaupten, dass ein externer Dritter (ITSG,
# GKV-Spitzenverband, gematik) etwas erteilt hat. Deshalb Env-Variable
# und kein Feature-Flag in der DB: ein Admin-Klick kann das nicht wahr
# machen. Nur der exakte String 'true' schaltet frei — '1', 'TRUE' oder
# ein Leerzeichen zu viel bedeuten gesperrt (fail-closed).
#
# Vollständige Freischaltliste: docs/KASSENABRECHNUNG_FREISCHALTUNG.md
# Aktueller Stand: GET /api/billing/dta/freigaben

# § 105 SGB XI — Übertragung an die Datenannahmestelle + Antwortabruf.
# Erst setzen, wenn ITSG-Zertifikat UND SFTP-Zugang vorliegen und eine
# Testübertragung (Dateiindikator '0') bestätigt wurde.
# ITSG_ZERTIFIZIERT=false

# § 302 SGB V — Erzeugung UND Versand für häusliche Krankenpflege.
# Erst setzen, wenn die Technische Anlage 1 vorliegt und der Generator
# implementiert ist (lib/abrechnung/sgb-v/generator.ts).
# SGB_V_302_FREIGABE=false

# KIM / Telematikinfrastruktur. Erst setzen, wenn gematik-Zulassung,
# Provider-Vertrag, Konnektor-Anbindung und TA5 vorliegen UND ein
# Provider-Adapter registriert ist (lib/kim/adapter.ts).
# KIM_AKTIV=false

# Passwort des PKCS#12-Zertifikats (SECON). Ohne diesen Wert ist der
# Private Key nicht lesbar und es wird nichts verschlüsselt — und ohne
# Verschlüsselung verlässt keine Datei das Haus.
# SECON_ZERT_PASSWORT=

# ─────────────────────────────────────────────────────────────────
# Institutionskennzeichen (IK) — Fallback
# ─────────────────────────────────────────────────────────────────
# Die IK des eigenen Betriebs steht führend in der Datenbank:
# organizations.ik_nummer der jeweiligen Organisation. getOrgIK()
# (lib/config/org-config.ts) löst in dieser Reihenfolge auf:
#   organizations.ik_nummer  →  ALLTAGSENGEL_IK  →  harter Fehler.
#
# Diese Variable ist im Normalbetrieb NICHT nötig und bewusst kein
# Standardwert: sie greift nur, wenn die organizations-Zeile fehlt oder
# nicht lesbar ist (neue Umgebung, Migration noch nicht angewendet,
# Organisation ohne gepflegte IK). Ohne DB-Wert UND ohne diese Variable
# wirft der Rechnungsweg — kein stiller falscher Wert, aber ein harter
# Fehler bei Rechnungs-PDF, Leistungsnachweis-PDF, XRechnung und
# DTA-Export.
#
# NICHT in app/ oder lib/ hartcodieren — das CI-Gate scripts/ci-ik-check.sh
# blockt jedes String-Literal der IK in der Geschäftslogik.
#
# 9-stellig, ohne Leerzeichen.
# ALLTAGSENGEL_IK=
